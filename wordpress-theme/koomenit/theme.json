{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "820px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{
					"slug": "primary",
					"name": "Blauw",
					"color": "#1d63ed"
				},
				{
					"slug": "secondary",
					"name": "Lichtblauw",
					"color": "#3b82f6"
				},
				{
					"slug": "node",
					"name": "Leisteengrijs",
					"color": "#94a3b8"
				},
				{
					"slug": "dark",
					"name": "Donker",
					"color": "#1e2430"
				},
				{
					"slug": "ink",
					"name": "Inkt",
					"color": "#0f172a"
				},
				{
					"slug": "light",
					"name": "Licht",
					"color": "#f1f5f9"
				},
				{
					"slug": "text",
					"name": "Tekst",
					"color": "#334155"
				},
				{
					"slug": "white",
					"name": "Wit",
					"color": "#ffffff"
				}
			],
			"gradients": [
				{
					"slug": "dark",
					"name": "Donker leisteen",
					"gradient": "linear-gradient(160deg, #1e2430 0%, #0f172a 100%)"
				},
				{
					"slug": "blue",
					"name": "Blauw",
					"gradient": "linear-gradient(120deg, #1d63ed 0%, #3b82f6 100%)"
				}
			]
		},
		"typography": {
			"fontSizes": [
				{
					"slug": "small",
					"name": "Klein",
					"size": "0.9rem"
				},
				{
					"slug": "medium",
					"name": "Normaal",
					"size": "1.0625rem"
				},
				{
					"slug": "large",
					"name": "Groot",
					"size": "1.35rem"
				},
				{
					"slug": "x-large",
					"name": "Extra groot",
					"size": "2.2rem"
				}
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				"border": {
					"radius": "12px"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#ffffff"
				},
				"typography": {
					"fontWeight": "700"
				}
			}
		}
	}
}
