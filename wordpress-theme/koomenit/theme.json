{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "820px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{
					"slug": "primary",
					"name": "Navy",
					"color": "#0e2a47"
				},
				{
					"slug": "secondary",
					"name": "Teal",
					"color": "#1f8a8a"
				},
				{
					"slug": "teal-light",
					"name": "Lichte teal",
					"color": "#3cb8b0"
				},
				{
					"slug": "steel",
					"name": "Staalblauw",
					"color": "#4c7a9e"
				},
				{
					"slug": "node",
					"name": "Netwerkgrijs",
					"color": "#8b97a3"
				},
				{
					"slug": "dark",
					"name": "Bijna zwart",
					"color": "#0b0e14"
				},
				{
					"slug": "light",
					"name": "Licht",
					"color": "#f2f5f8"
				},
				{
					"slug": "text",
					"name": "Tekst",
					"color": "#3d4a58"
				},
				{
					"slug": "white",
					"name": "Wit",
					"color": "#ffffff"
				}
			],
			"gradients": [
				{
					"slug": "navy",
					"name": "Navy naar staalblauw",
					"gradient": "linear-gradient(120deg, #0e2a47 0%, #4c7a9e 100%)"
				},
				{
					"slug": "teal",
					"name": "Teal",
					"gradient": "linear-gradient(120deg, #1f8a8a 0%, #3cb8b0 100%)"
				}
			]
		},
		"typography": {
			"fontSizes": [
				{
					"slug": "small",
					"name": "Klein",
					"size": "0.9rem"
				},
				{
					"slug": "medium",
					"name": "Normaal",
					"size": "1.0625rem"
				},
				{
					"slug": "large",
					"name": "Groot",
					"size": "1.35rem"
				},
				{
					"slug": "x-large",
					"name": "Extra groot",
					"size": "2.2rem"
				}
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				"border": {
					"radius": "10px"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#ffffff"
				},
				"typography": {
					"fontWeight": "600"
				}
			}
		}
	}
}
