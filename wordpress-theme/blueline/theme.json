{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": { "contentSize": "820px", "wideSize": "1200px" },
		"color": {
			"palette": [
				{ "slug": "primary", "name": "Primair blauw", "color": "#1d4ed8" },
				{ "slug": "secondary", "name": "Lichtblauw accent", "color": "#0ea5e9" },
				{ "slug": "dark", "name": "Donkerblauw", "color": "#0b1b3f" },
				{ "slug": "light", "name": "Licht", "color": "#f1f6ff" },
				{ "slug": "text", "name": "Tekst", "color": "#334155" },
				{ "slug": "white", "name": "Wit", "color": "#ffffff" }
			],
			"gradients": [
				{ "slug": "blue", "name": "Blauw verloop", "gradient": "linear-gradient(120deg, #0b1b3f 0%, #1d4ed8 100%)" },
				{ "slug": "sky", "name": "Hemelsblauw verloop", "gradient": "linear-gradient(120deg, #1d4ed8 0%, #0ea5e9 100%)" }
			]
		},
		"typography": {
			"fontSizes": [
				{ "slug": "small", "name": "Klein", "size": "0.9rem" },
				{ "slug": "medium", "name": "Normaal", "size": "1.0625rem" },
				{ "slug": "large", "name": "Groot", "size": "1.35rem" },
				{ "slug": "x-large", "name": "Extra groot", "size": "2.2rem" }
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				"border": { "radius": "999px" },
				"color": { "background": "var(--wp--preset--color--primary)", "text": "#ffffff" },
				"typography": { "fontWeight": "700" }
			}
		}
	}
}
